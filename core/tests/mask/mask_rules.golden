# insight-canon — the masking-rule golden (ROADMAP N74)
#
# One row per WITNESS:   rule_id | subject_token | input_line | expected_template [| declared]
#
# `expected_template` is the exact `StatelessTemplate::template_str` that
# `stateless_template(input_line, arena, MaskConfig{}, runs)` must return, where `runs` is the
# row's optional fifth field, one declared value spelled `<marker>=<value>` (DN-133.D1), and
# empty when the row has no fifth field. A masking rule that changes
# what a line canonicalises to moves one of these rows, and the gate reds WITHOUT waiting for
# anyone to remember `kCanonicalizationVersion` — which is the whole point: every other pin in the
# workspace fires on the VERSION and none fires on the RULES.
#
# `rule_id` is the rule the row exists to witness, and it is CHECKED, not merely declared:
# `test_mask_rule_golden.cpp` routes each composite subject back through the same catalog the
# dispatcher runs and reds if a different rule claims it. The population's coverage of the declared
# rule set (the 10 composite rules, the 8 ephemeral roots, the 6 wrapper pairs, the 4 status
# keywords, the currency markers) is likewise read from those catalogs, so a rule or entry added
# with no witness reds by NAME.
#
# Every line here is SYNTHETIC or first-party. This is a public repo: no third-party corpus byte
# lands in it, and no address, hash or path below belongs to anyone.
#
# TO CHANGE A VALUE: you cannot, without first bumping `kCanonicalizationVersion` in
# `core/api/canon.api.cppm`. The regenerator refuses otherwise. See the test file's header.
#
canonicalization_version = stateless-masks-17

# ── rule 1 — status-value KEEP. The green->red split, the one collapse masking may never make.
# One witness per declared status keyword; each is non-vacuous (remove the keyword, the value masks).
status_keep | 0 | process exited with exit code 0 | process exited with exit code 0
status_keep | 404 | request finished status 404 | request finished status 404
status_keep | 137 | container killed signal 137 | container killed signal 137
status_keep | 2 | worker returned exit 2 | worker returned exit 2
# DN-134.D1: the KEEP reads through a complete shell, exactly as the bare form.
status_keep | (1) | process exited with exit code (1) | process exited with exit code (1)
status_keep | (200), | request finished status (200), retrying | request finished status (200), retrying

# ── rule 3 — UUID / long hash. Letter-leading on purpose: a digit-leading hash would be masked by
# rule 5 anyway, and the row would name the wrong rule.
uuid_or_hash | deadbeefcafe0badf00d5678 | commit deadbeefcafe0badf00d5678 landed | commit <*> landed

# ── rule 4 — IPv4, the only knob-gated rule. It decides its WHOLE acceptance set (DN-134.D8): a bare
# address, one per declared wrapper pair (the shell whose absence once leaked a real address into a
# published render) and a closer-only form all mask with the knob ON and stay literal with it OFF,
# because rule 4 runs before rule 5 and the shelled-numeric reader and keeps what the switch keeps.
ipv4 | 10.0.0.1 | client 10.0.0.1 connected | client <*> connected
ipv4 | 10.0.0.1), | client 10.0.0.1), connected | client <*> connected
ipv4 | (10.0.0.1) | client (10.0.0.1) connected | client <*> connected
ipv4 | [10.0.0.1] | client [10.0.0.1] connected | client <*> connected
ipv4 | {10.0.0.1} | client {10.0.0.1} connected | client <*> connected
ipv4 | <10.0.0.1> | client <10.0.0.1> connected | client <*> connected
ipv4 | "10.0.0.1" | client "10.0.0.1" connected | client <*> connected
ipv4 | '10.0.0.1' | client '10.0.0.1' connected | client <*> connected

# ── rule 5 — digit-leading. One rule subsumes number+unit, percent, grouped, hex-with-0x, and the
# status-digit ceiling (a 4-digit value after a status keyword is an id, not a code).
digit_leading | 512MB | freed 512MB from cache | freed <*> from cache
digit_leading | 76.5% | done 76.5% of targets | done <*> of targets
digit_leading | 31,260 | compiled 31,260 targets | compiled <*> targets
digit_leading | 0xdeadbeef | fault at 0xdeadbeef now | fault at <*> now
digit_leading | 1234 | worker exit code 1234 | worker exit code <*>
digit_leading | 8080 | listening on port 8080 | listening on port <*>
# DN-134.D1: rule 5 reads a digit-leading core through a COMPLETE declared wrapper shell (opener at
# byte 0, the opener's own closer, at most two trailing bytes from `,;:.`), as rule 4 reads an
# address. The status KEEP reads through it: see the status_keep rows below.
digit_leading | (1.7s) | step finished in (1.7s) | step finished in <*>
digit_leading | (96.4%), | coverage (96.4%), above floor | coverage <*> above floor
digit_leading | [02:16:00] | [02:16:00] Starting deploy | <*> Starting deploy
digit_leading | "2220" | orphan pid "2220" killed | orphan pid <*> killed

# ── rule 6 — literal KEEP. The OVER-MASKING boundary: a rule that widened too far shows up here
# and nowhere else, and over-masking destroys signal irrecoverably.
literal_keep | eu-west | deploy region eu-west complete | deploy region eu-west complete
literal_keep | ORD-123 | order ORD-123 shipped | order ORD-123 shipped
literal_keep | $HOME | export $HOME to child | export $HOME to child
literal_keep | deadbeef | marker deadbeef seen | marker deadbeef seen
literal_keep | bazel-out/k8-fastbuild/bin/app | built bazel-out/k8-fastbuild/bin/app ok | built bazel-out/k8-fastbuild/bin/app ok
literal_keep | user=alice | login user=alice ok | login user=alice ok
literal_keep | utf8 | decode utf8 stream | decode utf8 stream
# DN-134.D1's boundary: an INCOMPLETE shell is no shell, so the count of `(25 warnings)` stays
# literal, and a letter-led core is a word.
literal_keep | (25 | build finished (25 warnings) | build finished (25 warnings)
literal_keep | (v1.2.3) | toolchain (v1.2.3) found | toolchain (v1.2.3) found
# The shape axis is closed for the opaque-identity class (ADR-16.D6): a word followed by a digit run
# is a stable name as often as an instance, so these stay verbatim and stay DISTINCT from each other.
# Each is a name the reverted opaque-identity rule collapsed; a shape rule re-entering reds here.
literal_keep | VK_KHR_maintenance1 | enabling VK_KHR_maintenance1 now | enabling VK_KHR_maintenance1 now
literal_keep | VK_KHR_maintenance7 | enabling VK_KHR_maintenance7 now | enabling VK_KHR_maintenance7 now
literal_keep | -DQT_QUICKCONTROLS2_LIB | compile -DQT_QUICKCONTROLS2_LIB flag | compile -DQT_QUICKCONTROLS2_LIB flag
literal_keep | libcc1plugin.so.0 | loading libcc1plugin.so.0 now | loading libcc1plugin.so.0 now

# ── rule 2, the composite layer — one section per declared rule of kCompositeRules, in its
# precedence order.

# diagnostic_composite — the general per-segment rule that subsumed source-location.
diagnostic_composite | tokenizer.cpp:4500:30: | error at tokenizer.cpp:4500:30: bad token | error at tokenizer.cpp:<*>:<*>: bad token
diagnostic_composite | [6226:0609/094020.430910:ERROR:dbus/bus.cc:408] | [6226:0609/094020.430910:ERROR:dbus/bus.cc:408] Failed to connect | [<*>:<*>/<*>:ERROR:dbus/bus.cc:<*>] Failed to connect
# DN-136.D4: a root reached behind a declared lead, or through `\` separators, masks the one component under it
# inside a location, and the file-and-line tail survives.
diagnostic_composite | (/tmp/run-a1/x.ts:12:5) | at (/tmp/run-a1/x.ts:12:5) here | at (/tmp/<*>/x.ts:<*>:<*>) here
diagnostic_composite | (C:\\Users\\u\\AppData\\Local\\Temp\\run-a1\\x.ts:12:5) | at (C:\\Users\\u\\AppData\\Local\\Temp\\run-a1\\x.ts:12:5) here | at (C:\\Users\\u\\AppData\\Local\\Temp\\<*>\\x.ts:<*>:<*>) here

# ephemeral_root — one witness per DECLARED root, with its declared anchor and scope visible in the
# expected value (Subtree collapses the remainder; Instance keeps the tail).
ephemeral_root | /tmp/pw-electron-userdata-Kw9v4a | opened /tmp/pw-electron-userdata-Kw9v4a ok | opened /tmp/<*> ok
ephemeral_root | /var/tmp/build-a1b2c3/out.log | wrote /var/tmp/build-a1b2c3/out.log ok | wrote /var/tmp/<*> ok
ephemeral_root | /var/folders/aB/cD/T/scratch | dir /var/folders/aB/cD/T/scratch ready | dir /var/folders/<*> ready
ephemeral_root | /home/runner/.conan2/p/b/insig247e3d1dffc33/p/lib/libx.so | loading /home/runner/.conan2/p/b/insig247e3d1dffc33/p/lib/libx.so now | loading /home/runner/.conan2/p/b/<*>/p/lib/libx.so now
ephemeral_root | /nix/store/abc123def456-glibc/lib/libc.so | mapping /nix/store/abc123def456-glibc/lib/libc.so now | mapping /nix/store/<*>/lib/libc.so now
ephemeral_root | /private/var/folders/8j/a1/T/x | dir /private/var/folders/8j/a1/T/x ready | dir /private/var/folders/<*> ready
ephemeral_root | /private/tmp/run-a1/x | dir /private/tmp/run-a1/x ready | dir /private/tmp/<*> ready
ephemeral_root | C:\Users\u\AppData\Local\Temp\run-a1\x.ts | open C:\Users\u\AppData\Local\Temp\run-a1\x.ts ok | open C:\Users\u\AppData\Local\Temp\<*> ok
# DN-136.D4: a path starts at byte 0 or right after a declared LEAD — a run of wrapper openers, an optional
# `<key>=`, an optional `file://` — so a TokenStart root is the path's first component behind it, and `\`
# separates components for the root predicate. A lead moves WHERE a root may sit, never what it matches.
ephemeral_root | file:///tmp/run-a1/x.ts | loading file:///tmp/run-a1/x.ts now | loading file:///tmp/<*> now
ephemeral_root | "/tmp/run-a1/s.json", | wrote "/tmp/run-a1/s.json", done | wrote "/tmp/<*> done
ephemeral_root | TMPDIR=/tmp/run-a1 | export TMPDIR=/tmp/run-a1 now | export TMPDIR=/tmp/<*> now
ephemeral_root | file:///C:/Users/u/AppData/Local/Temp/run-a1/x.ts | loading file:///C:/Users/u/AppData/Local/Temp/run-a1/x.ts now | loading file:///C:/Users/u/AppData/Local/Temp/<*> now
# DN-136.D4's boundary: a root that is not the path's first component, a lead outside the grammar (a `:` label,
# an escaped quote, a file URL with an authority), the runner's own temp folder, a bare root and a near-miss name.
literal_keep | /home/u/proj/tmp/x | copied /home/u/proj/tmp/x ok | copied /home/u/proj/tmp/x ok
literal_keep | build/tmp/x | copied build/tmp/x ok | copied build/tmp/x ok
literal_keep | user@host:/tmp/x | copied user@host:/tmp/x ok | copied user@host:/tmp/x ok
literal_keep | \"/tmp/x | copied \"/tmp/x ok | copied \"/tmp/x ok
literal_keep | /home/runner/work/_temp/cache-dir | copied /home/runner/work/_temp/cache-dir ok | copied /home/runner/work/_temp/cache-dir ok
literal_keep | (/tmp) | copied (/tmp) ok | copied (/tmp) ok
literal_keep | file://host/tmp/x | copied file://host/tmp/x ok | copied file://host/tmp/x ok
literal_keep | C:\Users\u\AppData\Local\Templates\x | copied C:\Users\u\AppData\Local\Templates\x ok | copied C:\Users\u\AppData\Local\Templates\x ok

# versioned_ref — keep the name, mask the version.
versioned_ref | zlib/1.3 | building zlib/1.3 from source | building zlib/<*> from source

# bracket_timestamp — the whole-token bracketed datetime; the bracket is the entire difference.
bracket_timestamp | [2026-06-23T15:11:09.020Z] | [2026-06-23T15:11:09.020Z] + git fetch | [<*>] + git fetch

# bracket_index — the class prefix inside the bracket survives; only the index is high-cardinality.
bracket_index | make[2]: | make[2]: entering directory | make[<*>]: entering directory
bracket_index | [gw0] | [gw0] PASSED test_alpha | [gw<*>] PASSED test_alpha

# hash_counter — keep the counter marker, mask the number.
hash_counter | #26 | step #26 done | step #<*> done
# DN-136.D1: the counter reads through a COMPLETE wrapper shell (§3.2 of masking.md), as rule 5 reads a number:
# the shell, the closer and the trailing bytes are kept, only the digits mask, and no param is pushed.
hash_counter | (#9767): | INFO (#9767): watcher | INFO (#<*>): watcher
hash_counter | [#42] | queued [#42] job | queued [#<*>] job
hash_counter | "#7", | tag "#7", ok | tag "#<*>", ok
hash_counter | (#9767) | merged (#9767) today | merged (#<*>) today
hash_counter | #9767): | INFO #9767): watcher | INFO #<*>): watcher
bracket_index | [42] | queued [42] job | queued [<*>] job
# DN-136.D1's boundary: a letter after the run, an incomplete shell, a byte before the opener, an empty core.
literal_keep | (#42a) | merged (#42a) today | merged (#42a) today
literal_keep | (#42 | merged (#42 today | merged (#42 today
literal_keep | fix(#123): | fix(#123): bump parser | fix(#123): bump parser
literal_keep | (#) | merged (#) today | merged (#) today

# marker_number — one witness per declared currency marker.
marker_number | $463.50 | charged $463.50 today | charged $<*> today

# embedded_identity — an id INSIDE a larger token: hash-in-path, a shell-only structure, and the
# compact UTC instant.
embedded_identity | f7f63412-b7a7-468d-bd31-1a6ae1ca2680 | session f7f63412-b7a7-468d-bd31-1a6ae1ca2680 opened | session <*> opened
embedded_identity | ~/.cache/gradle/f7f63412b7a7468dbd311a6ae1ca2680/lib.jar | reading ~/.cache/gradle/f7f63412b7a7468dbd311a6ae1ca2680/lib.jar ok | reading ~/.cache/gradle/<*>/lib.jar ok
embedded_identity | (d41d8cd98f00b204e9800998ecf8427e) | digest (d41d8cd98f00b204e9800998ecf8427e) ok | digest (<*>) ok
embedded_identity | /home/runner/work/_temp/2026-06-09T185733Z.json | wrote /home/runner/work/_temp/2026-06-09T185733Z.json ok | wrote /home/runner/work/_temp/<*>.json ok

# sanitizer_pid — the sanitizer-family process tag: keep both fences, mask the pid. A
# letter-leading tail glued to the closing fence is kept verbatim; a digit after it, or any byte
# before the opening fence, declines, and the token stays literal.
sanitizer_pid | ==4242== | ==4242== ERROR: harness timed out | ==<*>== ERROR: harness timed out
sanitizer_pid | ==77==ABORTING | ==77==ABORTING now | ==<*>==ABORTING now
literal_keep | ==77==3 | marker ==77==3 seen | marker ==77==3 seen
literal_keep | pin==26==3 | require pin==26==3 here | require pin==26==3 here

# kv_value — mask the value, keep the key.
# The status carve-out in key=value form (`status=200` stays literal) is homed as a
# literal_keep row DIRECTLY BELOW, and the reason is a MEASURED one this gate found on its
# first run: `normalize_kv_value` DECLINES a status key=value pair rather than claiming it
# and echoing it back, so the token falls through to rule 6 and rule 6 is what keeps it.
# The observable output is identical either way, which is exactly why the label had to be
# checked against the dispatcher instead of asserted — the row was written as `kv_value`
# from the docs and was wrong about WHICH rule protects the green->red split in KV form.
kv_value | order=100000 | checkout completed order=100000 | checkout completed order=<*>
kv_value | total=$18 | order completed total=$18 | order completed total=$<*>
literal_keep | status=200 | request status=200 returned | request status=200 returned

# declared_run — a run's own pull-request number, masked only behind a declared marker and only
# when it is the value the stream declares (DN-133.D1). Every literal control below differs from
# the witness by exactly one condition: another value, no value, no marker, the marker inside a
# word, a run that is not maximal. The composite row is the shadow case: a composite rule claims
# the token first, and the declared run reads its normal form. The digit-leading row is the
# whole-token mask winning over the declared run.
declared_run | /stirling/V2-PR-6656/docker-compose.yml | compose up /stirling/V2-PR-6656/docker-compose.yml now | compose up /stirling/V2-PR-<*>/docker-compose.yml now | PR-=6656
literal_keep | /stirling/V2-PR-6656/docker-compose.yml | compose up /stirling/V2-PR-6656/docker-compose.yml now | compose up /stirling/V2-PR-6656/docker-compose.yml now | PR-=6657
literal_keep | /stirling/V2-PR-6656/docker-compose.yml | compose up /stirling/V2-PR-6656/docker-compose.yml now | compose up /stirling/V2-PR-6656/docker-compose.yml now
literal_keep | python3 | interpreter python3 found | interpreter python3 found | PR-=3
literal_keep | XPR-6656 | label XPR-6656 applied | label XPR-6656 applied | PR-=6656
literal_keep | PR-66560 | label PR-66560 applied | label PR-66560 applied | PR-=6656
declared_run | deploy/pr-6656/main.go:42 | failed at deploy/pr-6656/main.go:42 here | failed at deploy/pr-<*>/main.go:<*> here | pr-=6656
digit_leading | 12-PR-6656 | build 12-PR-6656 queued | build <*> queued | PR-=6656
#
# The two markers DN-133.D7 admits, `PR#` and `pulls/`, each with the same one-condition controls:
# another value, the marker inside a word, a run that is not maximal, and `pull/` and `issues/`,
# shapes the set refuses, under the same value.
declared_run | PR#6656 | fetching changed files for PR#6656 now | fetching changed files for PR#<*> now | PR#=6656
literal_keep | PR#6656 | fetching changed files for PR#6656 now | fetching changed files for PR#6656 now | PR#=6657
literal_keep | XPR#6656 | fetching changed files for XPR#6656 now | fetching changed files for XPR#6656 now | PR#=6656
declared_run | /repos/o/r/pulls/6656/files | gh api /repos/o/r/pulls/6656/files done | gh api /repos/o/r/pulls/<*>/files done | pulls/=6656
literal_keep | /repos/o/r/pulls/66560/files | gh api /repos/o/r/pulls/66560/files done | gh api /repos/o/r/pulls/66560/files done | pulls/=6656
literal_keep | refs/pull/6656/merge | fetching refs/pull/6656/merge now | fetching refs/pull/6656/merge now | pulls/=6656
literal_keep | /repos/o/r/issues/6656/comments | gh api /repos/o/r/issues/6656/comments done | gh api /repos/o/r/issues/6656/comments done | pulls/=6656

# segment_kv — DN-134.D2: kv_value's disposition on each `;`-segment of a token's normal form, a
# non-claiming step after the composites and the literal KEEP (beside declared_run). A value masks
# over its number's extent (ADR-16.D15): a remainder of closers, `,;:.` and a token-final carriage
# return is swallowed, any other stays literal behind the wildcard. The literal controls: a status
# value per segment, `,` (not a delimiter).
segment_kv | id=build;outcome=success;duration_ms=12] | ##[end-action id=build;outcome=success;duration_ms=12] | ##[end-action id=build;outcome=success;duration_ms=<*>
segment_kv | item=book;total=$18 | order item=book;total=$18 placed | order item=book;total=$<*> placed
segment_kv | Import-Package=okio;version=1.15,javax.annotation;version=1.3,* | bundle Import-Package=okio;version=1.15,javax.annotation;version=1.3,* resolved | bundle Import-Package=okio;version=<*>,javax.annotation;version=<*>,* resolved
literal_keep | id=build;status=200 | finished id=build;status=200 now | finished id=build;status=200 now
literal_keep | id=build,duration_ms=12 | finished id=build,duration_ms=12 now | finished id=build,duration_ms=12 now

# json_member_order — DN-134.D3: a content that is, whole, one JSON value has the members of every
# object permuted into name order before tokenization; arrays keep their order. Each witness holds
# nothing a rule masks, so its template IS the permuted line.
json_member_order | {"result":"ok","event":"done"} | {"result":"ok","event":"done"} | {"event":"done","result":"ok"}
json_member_order | {"tags":["b","a"],"meta":{"z":true,"k":null}} | {"tags":["b","a"],"meta":{"z":true,"k":null}} | {"meta":{"k":null,"z":true},"tags":["b","a"]}
