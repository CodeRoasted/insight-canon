# insight-canon — the projection golden (the 2026-10-23 determinism audit, guard G6)
#
# canon's whole output for a named line population, read through the composed tokenizer with
# no semantic package: one `> input` line, then one `=` line holding the template id and every
# `render_projection` member, tab-separated, or `<no event>`. Each `== stream:` section runs
# through one fresh tokenizer in file order. An input escapes `\\`, tab, LF and CR as `\\`,
# `\t`, `\n` and `\r`.
#
# Every line is SYNTHETIC or first-party (the proof corpus is this repository's own).
#
# TO CHANGE A VALUE: you cannot, without first bumping `kCanonicalizationVersion` in
# `core/api/canon.api.cppm`; the regenerator refuses otherwise. See the test file's header.
#
canonicalization_version = stateless-masks-18

