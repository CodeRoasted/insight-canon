# windows-clang-release — the Windows (diff-only) Sift CLI target profile.
#
# STAGED PORTABILITY PROBE, not yet a ship gate. canon is proven OS-portable at the
# source level (Argos 2026-06-13): its only Linux coupling is libnuma, fully #ifdef
# INSIGHT_HAS_NUMA-gated, and the NUMA-off build is BIT-IDENTICAL to NUMA-on
# (det_public_proof.sh golden 65c062e0… matched with -DINSIGHT_CANON_ENABLE_NUMA=OFF).
# So a Windows canon yields output identical to full Linux — the deterministic-replay
# guarantee survives the port. What is NOT yet proven is the toolchain leg: C++23 named
# modules + `import std` under clang on Windows. This profile + the windows-portability-probe
# workflow exist to PROVE THAT, loudly, before any Windows binary is claimed.
#
# Compiler choice = clang (not MSVC, not mingw-gcc): clang's named-module + import-std
# support is the same family already proven on the clang-21/libc++ Linux leg, so the probe
# isolates "does the OS port work" from "does a different compiler family work". MSVC's
# module model and mingw-gcc's are separate unknowns deliberately NOT taken on here.
#
# NUMA is absent on Windows: conanfile.py gates `libnuma` to os==Linux and CMakeLists only
# find_package(libnuma) under LINUX, so INSIGHT_HAS_NUMA is never defined here — the portable
# arena allocator (::operator new(align_val_t)) is what compiles. fPIC is rm_safe'd on Windows
# by config_options(). No determinism flags differ: det_math is integer / no-libm; -ffp-contract=off
# is applied by CMakeLists for Clang/GNU/AppleClang alike (the generator expression already
# lists every compiler family), so the float-hardening is identical across OSes.
[settings]
arch=x86_64
build_type=Release
compiler=clang
compiler.version=21
compiler.cppstd=23
compiler.libcxx=libc++
os=Windows
# Clang on Windows can target either the MSVC ABI (clang-cl) or the GNU ABI. The Sift CLI is a
# self-contained static binary with no MSVC-runtime ABI surface to honour, and the proven Linux
# leg is GNU-driver clang — keep the same driver family so the probe varies ONE axis (the OS),
# not two (OS + ABI). runtime is therefore not an MSVC setting here.

[conf]
# Portable x86_64 baseline, MIRRORS the Linux profiles exactly so the cross-OS determinism
# comparison is flag-comparable (same -O3, same -march tier, same fp-contract handling).
# x86-64-v2 = SSE4.2/POPCNT/CX16 — safe on every GitHub windows-latest runner; -march=native
# would emit AVX the runner may not support.
tools.build:cflags=["-O3", "-march=x86-64-v2"]
tools.build:cxxflags=["-O3", "-march=x86-64-v2", "-stdlib=libc++"]
tools.build:exelinkflags=["-stdlib=libc++"]
tools.build:sharedlinkflags=["-stdlib=libc++"]
