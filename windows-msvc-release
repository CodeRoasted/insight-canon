# windows-msvc-release — the Windows (diff-only) Sift CLI target profile.
#
# STAGED PORTABILITY PROBE, not yet a ship gate. canon is proven OS-portable at the
# source level (Argos 2026-06-13): its only Linux coupling is libnuma, fully #ifdef
# INSIGHT_HAS_NUMA-gated, and the NUMA-off build is BIT-IDENTICAL to NUMA-on
# (det_public_proof.sh golden 65c062e0… matched with -DINSIGHT_CANON_ENABLE_NUMA=OFF).
# So a Windows canon yields output identical to full Linux at the algorithm level — the
# deterministic-replay guarantee survives the port.
#
# WHY MSVC, NOT CLANG (a probe-proven decision, not a default).
# The first Windows attempt used clang (windows-clang-release) to keep the SAME compiler
# family as the proven clang-21/libc++ Linux leg. It failed at the import-std generate step
# with CMake's "Only `libc++` and `libstdc++` are supported": the official LLVM Windows
# release ships NO libc++, so `-stdlib=libc++` is silently ignored and clang falls back to
# the MSVC STL, which CMake's CXX_MODULE_STD does not support. clang + import std on Windows
# is a dead end as of early 2026. The ONLY mature path is MSVC cl.exe, which ships std.ixx
# and has the most complete import-std support (VS 2022 17.5+ / toolset 14.34+). This is the
# documented Microsoft path. (Argos research 2026-06-13, sources in the probe workflow.)
#
# ⚠ DETERMINISM-MODEL FLAG FOR DAIDALOS (his ruling, not mine, before this is a SHIP gate):
# MSVC is a THIRD compiler family + a THIRD standard library (MSVC STL). The determinism
# contract today pins a TWO-leg cross-stdlib diagonal — gcc-15/libstdc++ ≡ clang-21/libc++
# must be byte-identical. A Windows/MSVC binary introduces a third stdlib whose floating /
# container / formatting behaviour is NOT in that diagonal. det_math is integer / no-libm by
# design, so the CANONICAL DIGEST should still hold — but "should" is a claim Daidalos must
# rule on: does the cross-OS bit-identity CLAIM extend to MSVC, or is Windows declared a
# "same-algorithm, separately-golden" leg? This profile + probe PROVE the toolchain compiles;
# they do NOT assert cross-stdlib byte-identity to the Linux golden. That assertion is gated
# on Daidalos's determinism-model ruling. (See insight_determinism_model.md.)
#
# NUMA is absent on Windows: conanfile.py gates `libnuma` to os==Linux and CMakeLists only
# find_package(libnuma) under LINUX, so INSIGHT_HAS_NUMA is never defined here — the portable
# arena allocator (::operator new(align_val_t)) compiles. fPIC is rm_safe'd on Windows by
# config_options(). -ffp-contract=off (the float-hardening) is applied by CMakeLists ONLY for
# GNU/Clang/AppleClang; MSVC's default is /fp:precise (no contraction) so no flag is needed —
# but see the Daidalos flag above: MSVC fp semantics are a determinism-model question, not a
# settled equivalence.
[settings]
arch=x86_64
build_type=Release
compiler=msvc
# 194 = VS 2022 17.10+ / MSVC 19.40 — the toolset on the windows-2022 runner. Supports import
# std (needs ≥ 14.34 / 17.5). NOT 195 (VS 2026): the windows-latest runner migrates to VS 2026
# mid-2026, so the probe PINS windows-2022 for a stable toolset (see the workflow runs-on).
compiler.version=194
compiler.cppstd=23
compiler.runtime=dynamic
compiler.runtime_type=Release
os=Windows

[conf]
# Ninja is mandatory for import std (CMake supports CXX_MODULE_STD only under Ninja generators,
# never the Visual Studio generator — it can't build the std BMI for imported targets). Conan's
# CMakeToolchain must emit Ninja, NOT a VS generator, or CMAKE_GENERATOR_TOOLSET leaks and breaks.
tools.cmake.cmaketoolchain:generator=Ninja
# NO -march here: that is a gcc/clang flag MSVC does not understand. MSVC's x64 default codegen
# (SSE2 baseline, /fp:precise) is the portable floor — the determinism-relevant equivalent of the
# Linux profiles' -march=x86-64-v2 + -ffp-contract=off, without a flag. Adding /arch:AVX2 would
# risk SIGILL on older runners (the same hazard the Linux profiles avoid) AND perturb fp codegen.
